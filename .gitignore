Prj2_TorreControl/herramientas/maqueta.html

# Lo que devolvió Power BI para comprobar la web (3 MB; se saca con web/pruebas/sacar_*.py con Desktop abierto)
Prj2_TorreControl/web/pruebas/esperado*.json
Prj2_TorreControl/web/pruebas/_*.json

