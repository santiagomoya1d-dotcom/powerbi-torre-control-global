			 & "</style><div class='t'>" & "<div class='cab'><div class='ti'>Por carretera<span class='pl l'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M2.5 7h11v9h-11z'/><path d='M13.5 10h4l3 3v3h-7'/><circle cx='6.5' cy='17.5' r='1.8'/><circle cx='17' cy='17.5' r='1.8'/></svg></span>camiones<br>y<span class='pl g'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='6' cy='18' r='2'/><circle cx='18' cy='6' r='2'/><path d='M8 18h7.5a3.5 3.5 0 0 0 0-7h-7a3.5 3.5 0 0 1 0-7H16'/></svg></span>proveedores</div>"
			        & "<div class='der'>" & IF ( ficticios, "<span class='fic'>Datos ficticios · simulación</span>" )
			        & "<div class='fe'><div class='ci'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='3.5' y='5' width='17' height='15' rx='3'/><path d='M3.5 10h17M8 3v4M16 3v4'/></svg></div><div><b>" & fecha & "</b><span>" & sub & "</span></div></div></div></div></div>"
		displayFolder: 7 · HTML
		lineageTag: f57ae3a8-3bbc-5bd0-b736-1f0452bcee12

	/// Filtro de la tabla de envíos de las páginas de modo: 1 si la carga está en tránsito a mediodía del día elegido.
	measure 'En tránsito ahora' =
			VAR t = [Momento]
			RETURN IF ( NOT ISEMPTY ( FILTER ( Envios, Envios[Salida] <= t && Envios[Entrega] > t ) ), 1 )
		formatString: 0
		displayFolder: 6 · Tablas
		lineageTag: b10465fd-d642-5db4-9155-625da7801ddd

	/// Días de puerto a puerto previstos de la ruta (solo si la ruta tiene envíos con los filtros actuales).
	measure 'Días previstos' = IF ( NOT ISEMPTY ( Envios ), MAX ( Rutas[Días previstos] ) )
		formatString: 0
		displayFolder: 6 · Tablas
		lineageTag: a868ce3d-76cd-5cd5-8d58-673b1cca0b6a

	/// Días medios de puerto a puerto de lo que llegó en los últimos 60 días.
	measure 'Días reales (60 d)' =
			VAR t = [Momento]
			RETURN CALCULATE ( AVERAGEX ( Envios, Envios[Llegada] - Envios[Salida] ), Envios[Llegada] > t - 60, Envios[Llegada] <= t )
		formatString: 0.0
		displayFolder: 6 · Tablas
		lineageTag: e92ca23d-b989-5229-85ff-9a03f4bceffc

	/// Valor en tránsito a mediodía de cada día de la curva (misma cifra que [Valor en tránsito (€)], calculada de una vez para todo el año).
	measure 'Tránsito diario (€)' = SUM ( 'Envios por día'[Valor] )
		formatString: #,0 €
		displayFolder: 2 · En tránsito
		lineageTag: 14a59599-512b-5317-b126-29e751d5fb14

	/// La misma curva en el escenario Base.
	measure 'Tránsito diario (Base)' = CALCULATE ( [Tránsito diario (€)], Escenarios[Escenario] = "Base" )
		formatString: #,0 €
		displayFolder: 2 · En tránsito
		lineageTag: 6ca430ee-423c-5f5f-b81f-88126aec16ce

	column Oculta
		isHidden
		lineageTag: 45fe9b41-064b-5c05-a107-c3e78124858a
		isNameInferred
		sourceColumn: [Oculta]

	partition Medidas = calculated
		mode: import
		source = ROW("Oculta", BLANK())

