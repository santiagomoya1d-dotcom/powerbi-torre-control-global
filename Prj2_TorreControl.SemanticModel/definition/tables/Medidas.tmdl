/// Tabla vacía que solo agrupa las medidas del informe
table Medidas
	lineageTag: f91c8cde-e3db-5959-84b5-0048006e16fa

	/// Día que se está viendo: el que se pincha en la curva o se elige en el calendario; si no hay ninguno, el de la tabla Torre (red.config.json). Con solo el día elegido, ese día del mes por defecto; con solo el mes, el mismo día de ese mes.
	measure 'Fecha elegida' =
			VAR d0 =
			    VAR d = MAX ( Torre[Fecha por defecto] )
			    RETURN IF ( NOT ISBLANK ( d ), d, CALCULATE ( MAX ( Calendario[Fecha] ), REMOVEFILTERS ( Calendario ) ) )
			VAR cand = VALUES ( Calendario[Fecha] )
			VAR n = COUNTROWS ( cand )
			VAR r =
			    SWITCH (
			        TRUE (),
			        n = 1, MAXX ( cand, Calendario[Fecha] ),
			        n = 0 || NOT ISFILTERED ( Calendario ), d0,
			        ISFILTERED ( Calendario[Día del mes] ),
			            MAXX ( FILTER ( cand, YEAR ( Calendario[Fecha] ) = YEAR ( d0 ) && MONTH ( Calendario[Fecha] ) = MONTH ( d0 ) ), Calendario[Fecha] ),
			        MAXX ( FILTER ( cand, DAY ( Calendario[Fecha] ) <= DAY ( d0 ) ), Calendario[Fecha] )
			    )
			RETURN COALESCE ( r, d0 )
		formatString: dd/mm/yyyy
		displayFolder: 1 · Momento
		lineageTag: 8921af8d-2e4b-546d-aefb-1f65ac3a1fc5

	/// Mediodía del día elegido: es el instante en que se fotografía la red (posiciones, envíos en tránsito).
	measure Momento = [Fecha elegida] + TIME ( 12, 0, 0 )
		formatString: dd/mm/yyyy hh:nn
		displayFolder: 1 · Momento
		lineageTag: 371418d2-9642-5cd9-b040-84bb83477ba9

	measure 'Escenario elegido' = SELECTEDVALUE ( Escenarios[Escenario], MAX ( Torre[Escenario por defecto] ) )
		displayFolder: 1 · Momento
		lineageTag: 3fc6222c-1410-50ab-99da-b3ec1da22d91

	measure 'Título del momento' =
			VAR d = [Fecha elegida]
			VAR nota = SELECTEDVALUE ( Torre[Nota de la fecha] )
			VAR pista = IF ( NOT HASONEVALUE ( Calendario[Fecha] ) && nota <> "", "  ·  " & nota )
			RETURN FORMAT ( d, "dddd, d ""de"" mmmm ""de"" yyyy", "es-ES" ) & pista
		displayFolder: 1 · Momento
		lineageTag: 94e68e8b-51f1-5b60-985d-6be7b1affdf1

	/// Contenedores, camiones y envíos aéreos que han salido y aún no se han entregado en el almacén.
	measure 'Envíos en tránsito' =
			VAR t = [Momento]
			RETURN CALCULATE ( COUNTROWS ( Envios ), Envios[Salida] <= t, Envios[Entrega] > t )
		formatString: #,0
		displayFolder: 2 · En tránsito
		lineageTag: 174ae06e-db9c-541d-80fa-2cb6a74ef62b

	measure 'Valor en tránsito (€)' =
			VAR t = [Momento]
			RETURN CALCULATE ( SUM ( Envios[Valor (€)] ), Envios[Salida] <= t, Envios[Entrega] > t )
		formatString: #,0 €
		displayFolder: 2 · En tránsito
		lineageTag: 8860e948-9b10-5f8e-b525-364286f2e0c6

	/// En tránsito y con más de dos días de retraso sobre la entrega prevista al hacer el pedido.
	measure 'Envíos retrasados en tránsito' =
			VAR t = [Momento]
			RETURN CALCULATE ( COUNTROWS ( Envios ), Envios[Salida] <= t, Envios[Entrega] > t, Envios[Retraso (días)] > 2 )
		formatString: #,0
		displayFolder: 2 · En tránsito
		lineageTag: dfce70b9-8c94-5478-ac0c-77836f0c2bf7

	measure 'Valor retrasado en tránsito (€)' =
			VAR t = [Momento]
			RETURN CALCULATE ( SUM ( Envios[Valor (€)] ), Envios[Salida] <= t, Envios[Entrega] > t, Envios[Retraso (días)] > 2 )
		formatString: #,0 €
		displayFolder: 2 · En tránsito
		lineageTag: c000102b-7c71-53da-90ba-8df0d6068588

	measure 'Buques en el mar' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( DISTINCTCOUNT ( Posiciones[ViajeID] ), Posiciones[Fecha] = d, Viajes[Modo] = "Marítimo" )
		formatString: #,0
		displayFolder: 2 · En tránsito
		lineageTag: 04af60b8-0350-5d1e-b0ff-3ebf98f74a0c

	measure 'Vuelos en el aire' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( DISTINCTCOUNT ( Posiciones[ViajeID] ), Posiciones[Fecha] = d, Viajes[Modo] = "Aéreo" )
		formatString: #,0
		displayFolder: 2 · En tránsito
		lineageTag: 370889a7-02c3-5bf6-a9f4-83d8f5a5a031

	measure 'Camiones en ruta' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( DISTINCTCOUNT ( Posiciones[ViajeID] ), Posiciones[Fecha] = d, Viajes[Modo] = "Carretera" )
		formatString: #,0
		displayFolder: 2 · En tránsito
		lineageTag: 4785f98e-fa06-54e5-997e-e9551476b1ee

	/// Buques que ya han llegado y esperan atraque frente al puerto.
	measure 'Buques fondeados' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( DISTINCTCOUNT ( Posiciones[ViajeID] ), Posiciones[Fecha] = d, Posiciones[Estado] = "Fondeado" )
		formatString: #,0
		displayFolder: 2 · En tránsito
		lineageTag: 6e33b409-eaf5-5053-b8cf-645594d29e41

	/// Envíos entregados en el almacén en los 30 días anteriores al momento elegido.
	measure 'Entregas (30 días)' =
			VAR t = [Momento]
			RETURN CALCULATE ( COUNTROWS ( Envios ), Envios[Entrega] > t - 30, Envios[Entrega] <= t )
		formatString: #,0
		displayFolder: 3 · Servicio
		lineageTag: c7408197-d058-5d46-a067-6bbecf399d31

	/// Entregas de los últimos 30 días con dos días de retraso o menos.
	measure 'Puntualidad %' =
			VAR t = [Momento]
			RETURN DIVIDE ( CALCULATE ( COUNTROWS ( Envios ), Envios[Entrega] > t - 30, Envios[Entrega] <= t, Envios[Retraso (días)] <= 2 ), [Entregas (30 días)] )
		formatString: 0.0%
		displayFolder: 3 · Servicio
		lineageTag: fb4ca589-192e-57db-889a-7f886b95b76e

	measure 'Retraso medio (días)' =
			VAR t = [Momento]
			RETURN CALCULATE ( AVERAGEX ( Envios, MAX ( Envios[Retraso (días)], 0 ) ), Envios[Entrega] > t - 30, Envios[Entrega] <= t )
		formatString: 0.0
		displayFolder: 3 · Servicio
		lineageTag: 80e84919-84a5-52d6-9cbb-a9aa431190e5

	/// Días desde que la carga sale del origen hasta que entra en el almacén (entregas de los últimos 30 días).
	measure 'Puerta a puerta (días)' =
			VAR t = [Momento]
			RETURN CALCULATE ( AVERAGEX ( Envios, ( Envios[Entrega] - Envios[Salida] ) * 1.0 ), Envios[Entrega] > t - 30, Envios[Entrega] <= t )
		formatString: 0.0
		displayFolder: 3 · Servicio
		lineageTag: d26ab48e-0bf4-5127-8df7-46aed15c1d07

	/// Flete de las cargas que salieron en los 30 días anteriores (tarifas ilustrativas).
	measure 'Flete (30 días)' =
			VAR t = [Momento]
			RETURN CALCULATE ( SUM ( Envios[Flete (€)] ), Envios[Salida] > t - 30, Envios[Salida] <= t )
		formatString: #,0 €
		displayFolder: 3 · Servicio
		lineageTag: 8eb3d3ee-cd1f-58ad-919a-ab9371252f35

	measure 'Valor en tránsito (Base)' = CALCULATE ( [Valor en tránsito (€)], Escenarios[Escenario] = "Base" )
		formatString: #,0 €
		displayFolder: 4 · Frente a Base
		lineageTag: bb549fc4-2a76-50a4-acc5-fb74654f4537

	measure 'Envíos en tránsito (Base)' = CALCULATE ( [Envíos en tránsito], Escenarios[Escenario] = "Base" )
		formatString: #,0
		displayFolder: 4 · Frente a Base
		lineageTag: baaf89b4-63a6-5c70-8d63-952eea17092d

	measure 'Puntualidad (Base)' = CALCULATE ( [Puntualidad %], Escenarios[Escenario] = "Base" )
		formatString: 0.0%
		displayFolder: 4 · Frente a Base
		lineageTag: c4c54600-e196-5bcb-a358-4b1c9ddd1598

	measure 'Retraso medio (Base)' = CALCULATE ( [Retraso medio (días)], Escenarios[Escenario] = "Base" )
		formatString: 0.0
		displayFolder: 4 · Frente a Base
		lineageTag: 10a9b3c9-ee14-584f-bc37-be0e605c61bc

	measure 'Puerta a puerta (Base)' = CALCULATE ( [Puerta a puerta (días)], Escenarios[Escenario] = "Base" )
		formatString: 0.0
		displayFolder: 4 · Frente a Base
		lineageTag: 66a00ec5-2e22-5665-92a9-bb6b7c8ebda4

	measure 'Flete (Base)' = CALCULATE ( [Flete (30 días)], Escenarios[Escenario] = "Base" )
		formatString: #,0 €
		displayFolder: 4 · Frente a Base
		lineageTag: e37c7a5f-cec8-5884-ad53-b2ef509e3f90

	/// Longitud del viaje a mediodía del día elegido. En blanco si ese día no está en ruta: así el globo solo recibe lo que se mueve.
	measure 'Lon hoy' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( MAX ( Posiciones[Lon] ), Posiciones[Fecha] = d )
		formatString: 0.000
		displayFolder: 5 · Globo
		lineageTag: 4ec21be5-b445-5f57-b6ff-5eaf531a6920

	measure 'Lat hoy' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( MAX ( Posiciones[Lat] ), Posiciones[Fecha] = d )
		formatString: 0.000
		displayFolder: 5 · Globo
		lineageTag: a1f94638-55d1-5d72-8944-8fd5dcd82011

	measure 'Lon siguiente hoy' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( MAX ( Posiciones[Lon siguiente] ), Posiciones[Fecha] = d )
		formatString: 0.000
		displayFolder: 5 · Globo
		lineageTag: 6d508e38-43e3-5df4-8e23-5715e7f7f920

	measure 'Lat siguiente hoy' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( MAX ( Posiciones[Lat siguiente] ), Posiciones[Fecha] = d )
		formatString: 0.000
		displayFolder: 5 · Globo
		lineageTag: 981cc46d-d559-5bfc-85fd-ed020ab8e993

	measure 'Progreso hoy' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( MAX ( Posiciones[Progreso] ), Posiciones[Fecha] = d )
		formatString: 0.000
		displayFolder: 5 · Globo
		lineageTag: bab0c38c-f7a0-5814-8ad2-075ccb0e1aa9

	measure 'Estado hoy' =
			VAR d = [Fecha elegida]
			RETURN CALCULATE ( SELECTEDVALUE ( Posiciones[Estado] ), Posiciones[Fecha] = d )
		displayFolder: 5 · Globo
		lineageTag: 86375b90-45a6-5ce9-90d6-521ef99a0ad2

	/// Cargas del viaje que pasan los filtros de categoría y proveedor (0 = el viaje se dibuja atenuado).
	measure 'Contenedores del viaje' = IF ( NOT ISBLANK ( [Lon hoy] ), COALESCE ( COUNTROWS ( Envios ), 0 ) )
		formatString: #,0
		displayFolder: 5 · Globo
		lineageTag: e50451f3-0915-5ef6-920c-084b1898c1d2

	measure 'Contenedores sin filtro' = IF ( NOT ISBLANK ( [Lon hoy] ), CALCULATE ( COUNTROWS ( Envios ), REMOVEFILTERS ( 'Categorías' ), REMOVEFILTERS ( Proveedores ) ) )
		formatString: #,0
		displayFolder: 5 · Globo
		lineageTag: 1bfc81ed-f271-545a-850e-57368047db6f

	measure 'Retraso del viaje' = IF ( NOT ISBLANK ( [Lon hoy] ), CALCULATE ( MAX ( Envios[Retraso (días)] ), REMOVEFILTERS ( 'Categorías' ), REMOVEFILTERS ( Proveedores ) ) )
		formatString: 0.0
		displayFolder: 5 · Globo
		lineageTag: 04d2646e-15f7-5678-a0ed-95686aeaa30e

	measure 'Valor del viaje (texto)' =
			IF (
			    NOT ISBLANK ( [Lon hoy] ),
			    VAR v = CALCULATE ( SUM ( Envios[Valor (€)] ), REMOVEFILTERS ( 'Categorías' ), REMOVEFILTERS ( Proveedores ) )
			    RETURN IF ( v >= 1000000, FORMAT ( v / 1000000, "0.0", "es-ES" ) & " M€", FORMAT ( v / 1000, "0", "es-ES" ) & " mil €" )
			)
		displayFolder: 5 · Globo
		lineageTag: 2bcb7945-19c6-5257-9693-627eb9298eef

	measure 'Categorías del viaje' =
			IF (
			    NOT ISBLANK ( [Lon hoy] ),
			    CALCULATE ( CONCATENATEX ( VALUES ( Envios[Categoría] ), Envios[Categoría], ", ", Envios[Categoría], ASC ), REMOVEFILTERS ( 'Categorías' ), REMOVEFILTERS ( Proveedores ) )
			)
		displayFolder: 5 · Globo
		lineageTag: 3e301f15-3f53-5199-a357-fe0ddde6b830

	measure 'Llegada prevista del viaje' =
			IF (
			    NOT ISBLANK ( [Lon hoy] ),
			    VAR r = [Retraso del viaje]
			    VAR fin = CALCULATE ( MAX ( Envios[Entrega] ), REMOVEFILTERS ( 'Categorías' ), REMOVEFILTERS ( Proveedores ) )
			    VAR plan = CALCULATE ( MIN ( Envios[Entrega prevista] ), REMOVEFILTERS ( 'Categorías' ), REMOVEFILTERS ( Proveedores ) )
			    RETURN FORMAT ( fin, "dd/mm" ) & IF ( r > 0.5, " (plan inicial " & FORMAT ( plan, "dd/mm" ) & ")" )
			)
		displayFolder: 5 · Globo
		lineageTag: bf6432e1-5df3-5cb9-9bf5-a1b3d5b600b0

	/// Día elegido en texto ISO, solo en las filas en ruta (el globo calcula con él la noche).
	measure 'Fecha del globo' = IF ( NOT ISBLANK ( [Lon hoy] ), FORMAT ( [Fecha elegida], "yyyy-mm-dd" ) )
		displayFolder: 5 · Globo
		lineageTag: 37312bc7-b489-5cc1-b87a-2766f9395489

	measure 'Escenario del globo' = IF ( NOT ISBLANK ( [Lon hoy] ), [Escenario elegido] )
		displayFolder: 5 · Globo
		lineageTag: a1fb63d5-3e9e-53e7-99a4-8da47946da61

	measure 'Color de categoría' = SELECTEDVALUE ( 'Categorías'[Color], "#64748B" )
		displayFolder: 6 · Colores
		lineageTag: 8644baa2-66ad-515c-8481-4944609b79d0

	/// Título de la página, día que se está viendo y aviso de datos ficticios.
	measure 'HTML · Cabecera' =
			VAR nombre = COALESCE ( SELECTEDVALUE ( Torre[Nombre] ), "Torre de control" )
			VAR ficticios = SELECTEDVALUE ( Torre[Datos ficticios] ) = "Sí"
			VAR esc = [Escenario elegido]
			VAR descEsc = LOOKUPVALUE ( Escenarios[Descripción], Escenarios[Escenario], esc )
			VAR nota = IF ( NOT ISFILTERED ( Calendario ) && esc = MAX ( Torre[Escenario por defecto] ), SELECTEDVALUE ( Torre[Nota de la fecha] ) )
			VAR sub = IF ( nota <> "", nota, descEsc )
			VAR fecha = FORMAT ( [Fecha elegida], "dddd, d ""de"" mmmm ""de"" yyyy", "es-ES" )
			RETURN
			    "<style>" & 
			"html,body{margin:0;padding:0;overflow:hidden;background:transparent}*{box-sizing:border-box}.t{--ink:#161616;--ink2:#3B3D3A;--mut:#6F746C;--fai:#B9BDB5;--lin:#E2E5DF;--card:#F7F8F5;--lime:#E2F27A;--coral:#EF5A3C;--amber:#F0AE3A;font-family:'Segoe UI Variable Display','Segoe UI Variable Text','Segoe UI',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;height:100vh}svg .b{animation:sube .9s cubic-bezier(.2,.8,.2,1) both;transform-box:fill-box;transform-origin:bottom}.cab{display:flex;justify-content:space-between;align-items:flex-start;height:100%}.ti{font-size:50px;font-weight:400;letter-spacing:-.035em;line-height:1.06;white-space:nowrap}.pl{display:inline-flex;align-items:center;justify-content:center;width:62px;height:40px;border-radius:999px;vertical-align:6px;margin:0 6px}.pl svg{width:21px;height:21px}.pl.g{background:#fff;border:1px solid var(--lin)}.pl.l{background:var(--lime)}.der{display:flex;align-items:center;gap:10px;margin-top:22px}.fe{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--lin);border-radius:999px;padding:7px 18px 7px 8px}.fe .ci{width:34px;height:34px;border-radius:50%;background:var(--card);display:flex;align-items:center;justify-content:center}.fe .ci svg{width:17px;height:17px}.fe b{display:block;font-size:14px;font-weight:600}.fe span{display:block;font-size:11.5px;color:var(--mut)}.fe b::first-letter,.fe span::first-letter{text-transform:uppercase}.fic{font-size:11.5px;font-weight:600;border-radius:999px;padding:9px 14px;border:1px dashed var(--fai);color:var(--ink2);white-space:nowrap}@keyframes sube{from{transform:scaleY(0)}}"
			 & "</style><div class='t'>" & "<div class='cab'><div class='ti'>" & nombre & "<span class='pl l'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='9'/><ellipse cx='12' cy='12' rx='4' ry='9'/><path d='M3 12h18'/></svg></span>de la red<br>y<span class='pl g'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M3 15h18l-2.4 5H5.4z'/><path d='M6 15V9.5h12V15'/><path d='M9.5 9.5V6h5v3.5'/></svg></span>sus rutas</div>"
			        & "<div class='der'>" & IF ( ficticios, "<span class='fic'>Datos ficticios · simulación</span>" )
			        & "<div class='fe'><div class='ci'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><rect x='3.5' y='5' width='17' height='15' rx='3'/><path d='M3.5 10h17M8 3v4M16 3v4'/></svg></div><div><b>" & fecha & "</b><span>" & sub & "</span></div></div></div></div></div>"
		displayFolder: 7 · HTML
		lineageTag: 772d78e9-6e36-5a76-a243-de66bfc12403

	/// Riesgo de rotura: cargas cuyo retraso supera los días de cobertura de su categoría, agrupadas por proveedor.
	measure 'HTML · Alertas' =
			VAR alerta = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M12 3.5 2.8 19.5h18.4z'/><path d='M12 10v4.5M12 17.2v.3'/></svg>"
			VAR t = [Momento]
			VAR enTransito =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( Envios, Envios[Salida] <= t, Envios[Entrega] > t ),
			            "@cob", RELATED ( 'Categorías'[Cobertura (días)] ),
			            "@ciudad", RELATED ( Proveedores[Ciudad] ),
			            "@color", RELATED ( 'Categorías'[Color] )
			        ),
			        Envios[Retraso (días)] > 2
			    )
			VAR conHolgura = ADDCOLUMNS ( enTransito, "@hol", Envios[Retraso (días)] - [@cob] )
			VAR riesgo = FILTER ( conHolgura, [@hol] > 0 )
			VAR nRiesgo = COALESCE ( COUNTROWS ( riesgo ), 0 )
			VAR vRiesgo = COALESCE ( SUMX ( riesgo, Envios[Valor (€)] ), 0 )
			VAR grupos =
			    GROUPBY (
			        conHolgura,
			        Envios[ProveedorID],
			        "@ciudadG", MAXX ( CURRENTGROUP (), [@ciudad] ),
			        "@catG", MAXX ( CURRENTGROUP (), Envios[Categoría] ),
			        "@colorG", MAXX ( CURRENTGROUP (), [@color] ),
			        "@cobG", MAXX ( CURRENTGROUP (), [@cob] ),
			        "@nG", SUMX ( CURRENTGROUP (), 1 ),
			        "@nrG", SUMX ( CURRENTGROUP (), IF ( [@hol] > 0, 1, 0 ) ),
			        "@holG", MAXX ( CURRENTGROUP (), [@hol] ),
			        "@retG", MAXX ( CURRENTGROUP (), Envios[Retraso (días)] ),
			        "@valorG", SUMX ( CURRENTGROUP (), Envios[Valor (€)] )
			    )
			VAR lista =
			    CONCATENATEX (
			        TOPN ( 5, grupos, [@holG], DESC, [@valorG], DESC ),
			        "<div class='it'><div class='ini'>" & RIGHT ( Envios[ProveedorID], 2 ) & "<i style='background:" & [@colorG] & "'></i></div>"
			            & "<div class='tx'><div class='t1'>" & [@ciudadG] & "<span class='ct'>" & [@catG] & "</span></div><div class='t2'>"
			            & IF ( [@nrG] > 0, IF ( [@nrG] = [@nG], [@nG] & IF ( [@nG] = 1, " carga sin stock", " cargas sin stock" ), [@nrG] & " de " & [@nG] & " cargas sin stock" ), [@nG] & IF ( [@nG] = 1, " carga", " cargas" ) & " con retraso" )
			            & " · " & FORMAT ( [@valorG] / 1000, "#,0", "es-ES" ) & " mil € · cubre " & [@cobG] & " d</div></div>"
			            & "<span class='dd " & IF ( [@nrG] > 0, "rot", "ret" ) & "'>+" & FORMAT ( [@retG], "0", "es-ES" ) & " d</span></div>",
			        "", [@holG], DESC, [@valorG], DESC
			    )
			RETURN
			    "<style>" & 
			"html,body{margin:0;padding:0;overflow:hidden;background:transparent}*{box-sizing:border-box}.t{--ink:#161616;--ink2:#3B3D3A;--mut:#6F746C;--fai:#B9BDB5;--lin:#E2E5DF;--card:#F7F8F5;--lime:#E2F27A;--coral:#EF5A3C;--amber:#F0AE3A;font-family:'Segoe UI Variable Display','Segoe UI Variable Text','Segoe UI',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;height:100vh}.hd{display:flex;align-items:center;gap:12px}.hd .tt{font-size:15px;font-weight:600;letter-spacing:-.01em;flex:1;min-width:0}.hd .tt em{display:block;font-style:normal;font-size:11.5px;font-weight:400;color:var(--mut);letter-spacing:0;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chip{width:36px;height:36px;border-radius:12px;background:#fff;border:1px solid var(--lin);display:flex;align-items:center;justify-content:center;flex:none}.chip svg{width:19px;height:19px}.bdg{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;border-radius:999px;padding:5px 10px;background:var(--lime);align-self:center;margin-left:auto;white-space:nowrap}.bdg.neg{background:var(--ink);color:var(--lime)}.bdg svg{width:13px;height:13px}.al{display:flex;flex-direction:column;gap:8px;height:100%}.ca{background:var(--card);border-radius:24px;padding:16px 18px}.res{display:flex;align-items:baseline;gap:10px;margin-top:10px}.res b{font-size:44px;font-weight:300;letter-spacing:-.045em;line-height:1}.res .rl{font-size:13px;color:var(--ink2);line-height:1.25}.it{display:flex;align-items:center;gap:12px;background:var(--card);border-radius:20px;padding:10px 14px 10px 10px}.ini{width:40px;height:40px;border-radius:13px;background:#fff;border:1px solid var(--lin);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;position:relative;flex:none}.in"
			& "i i{position:absolute;right:-3px;top:-3px;width:11px;height:11px;border-radius:50%;border:2px solid var(--card)}.it .tx{flex:1;min-width:0}.t1{font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ct{font-size:10.5px;font-weight:500;color:var(--ink2);background:#fff;border:1px solid var(--lin);border-radius:999px;padding:1px 7px;margin-left:7px;vertical-align:1px}.t2{font-size:11.5px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}.dd{font-size:12px;font-weight:600;border-radius:999px;padding:4px 9px;white-space:nowrap}.dd.rot{background:var(--ink);color:var(--lime)}.dd.ret{background:#fff;border:1px solid var(--lin)}.ok{font-size:13px;color:var(--ink2)}svg .b{animation:sube .9s cubic-bezier(.2,.8,.2,1) both;transform-box:fill-box;transform-origin:bottom}@keyframes sube{from{transform:scaleY(0)}}"
			 & "</style><div class='t'>" & "<div class='al'><div class='ca'><div class='hd'><div class='chip'>" & alerta & "</div><div class='tt'>Riesgo de rotura en el almacén<em>el retraso supera los días de stock de seguridad</em></div></div>"
			        & "<div class='res'><b>" & nRiesgo & "</b><span class='rl'>" & IF ( nRiesgo = 1, "carga llegará<br>sin stock", "cargas llegarán<br>sin stock" ) & "</span>"
			        & "<span class='bdg" & IF ( nRiesgo > 0, " neg'>" & FORMAT ( vRiesgo / 1000000, "0.0", "es-ES" ) & " M€", "'>sin riesgo" ) & "</span></div></div>"
			        & IF ( ISEMPTY ( enTransito ), "<div class='ca ok'>Ninguna carga en tránsito va con más de dos días de retraso.</div>", lista )
			        & "</div></div>"
		displayFolder: 7 · HTML
		lineageTag: eb93f711-6376-5c17-9f9c-a00539b02813

	/// Llegadas al almacén en los próximos 14 o 30 días (selector de la tarjeta): cápsula lima a tiempo y negra con retraso.
	measure 'HTML · Llegadas' =
			VAR icoBarras = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><path d='M5 20V11M10 20V5M15 20v-6M20 20V9'/></svg>"
			VAR meses = "ene feb mar abr may jun jul ago sep oct nov dic "
			VAR t = [Momento]
			VAR hoy = INT ( t )
			VAR nd = COALESCE ( SELECTEDVALUE ( Horizonte[Días] ), 14 )
			VAR ent =
			    CALCULATETABLE (
			        SELECTCOLUMNS ( Envios, "@dia", INT ( Envios[Entrega] ), "@val", Envios[Valor (€)], "@tarde", IF ( Envios[Retraso (días)] > 2, 1, 0 ) ),
			        Envios[Entrega] >= hoy, Envios[Entrega] < hoy + nd
			    )
			VAR dias =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, nd - 1, 1 ),
			        "@d", hoy + [Value],
			        "@v", VAR a = hoy + [Value] RETURN SUMX ( FILTER ( ent, [@dia] = a ), [@val] ) + 0,
			        "@r", VAR a = hoy + [Value] RETURN SUMX ( FILTER ( ent, [@dia] = a && [@tarde] = 1 ), [@val] ) + 0,
			        "@n", VAR a = hoy + [Value] RETURN COUNTROWS ( FILTER ( ent, [@dia] = a ) ) + 0,
			        "@nr", VAR a = hoy + [Value] RETURN COUNTROWS ( FILTER ( ent, [@dia] = a && [@tarde] = 1 ) ) + 0
			    )
			VAR mx = MAX ( MAXX ( dias, [@v] ), 1 )
			VAR paso = IF ( mx <= 1000000, 100000, IF ( mx <= 2000000, 200000, 500000 ) )
			VAR tope = ( INT ( mx / paso ) + 1 ) * paso
			VAR ancho = ( 840 - 34 ) / nd
			VAR bw = MIN ( 30, ancho * 0.72 )
			VAR rr = bw / 2
			VAR cada = IF ( nd > 14, 2, 1 )
			VAR rejilla =
			    CONCATENATEX (
			        GENERATESERIES ( 0, INT ( tope / paso ), 1 ),
			        VAR y = 136 - [Value] * paso / tope * 128
			        RETURN "<line x1='34' x2='840' y1='" & FORMAT ( y, "0.0", "en-US" ) & "' y2='" & FORMAT ( y, "0.0", "en-US" ) & "' stroke='#E2E5DF'/>"
			            & "<text x='26' y='" & FORMAT ( y + 3.5, "0.0", "en-US" ) & "' text-anchor='end' font-size='10' fill='#8A8F87'>" & FORMAT ( [Value] * paso / 1000000, "0.0", "es-ES" ) & "</text>",
			        "", [Value], ASC
			    )
			VAR barras =
			    CONCATENATEX (
			        dias,
			        VAR cx = 34 + ancho * ( [Value] + 0.5 )
			        VAR x = cx - rr
			        VAR h = MAX ( [@v] / tope * 128, bw )
			        VAR hr = [@r] / tope * 128
			        VAR hr2 = MIN ( MAX ( hr, bw ), h )
			        VAR ytop = 136 - h
			        VAR dd = [@d]
			        VAR dia = DAY ( dd ) & " " & TRIM ( MID ( meses, ( MONTH ( dd ) - 1 ) * 4 + 1, 4 ) )
			        VAR yl = IF ( hr > 0.5, ytop + hr2 + rr, ytop + rr )
			        RETURN
			            IF ( MOD ( [Value], cada ) = 0,
			                "<text x='" & FORMAT ( cx, "0.0", "en-US" ) & "' y='158' text-anchor='middle' font-size='11' font-weight='" & IF ( [Value] = 0, "700", "400" )
			                    & "' fill='" & IF ( [Value] = 0, "#161616", IF ( WEEKDAY ( dd, 2 ) >= 6, "#A3A79F", "#6F746C" ) ) & "'>" & dia & "</text>" )
			            & IF ( [@v] <= 0,
			                "<rect x='" & FORMAT ( x, "0.0", "en-US" ) & "' y='12' width='" & FORMAT ( bw, "0.0", "en-US" ) & "' height='124' rx='" & FORMAT ( rr, "0.0", "en-US" ) & "' fill='none' stroke='#B9BDB5' stroke-width='1.3' stroke-dasharray='4 4'/>"
			                    & "<circle cx='" & FORMAT ( cx, "0.0", "en-US" ) & "' cy='" & FORMAT ( 12 + rr, "0.0", "en-US" ) & "' r='" & FORMAT ( rr * 0.4, "0.0", "en-US" ) & "' fill='#B9BDB5'/>",
			                "<rect class='b' x='" & FORMAT ( x, "0.0", "en-US" ) & "' y='" & FORMAT ( ytop, "0.0", "en-US" ) & "' width='" & FORMAT ( bw, "0.0", "en-US" ) & "' height='" & FORMAT ( h, "0.0", "en-US" ) & "' rx='" & FORMAT ( rr, "0.0", "en-US" ) & "' fill='#E2F27A'/>"
			                    & IF ( hr > 0.5,
			                        "<path class='b' d='M" & FORMAT ( x, "0.0", "en-US" ) & "," & FORMAT ( ytop + hr2, "0.0", "en-US" ) & " V" & FORMAT ( ytop + rr, "0.0", "en-US" ) & " a" & FORMAT ( rr, "0.0", "en-US" ) & "," & FORMAT ( rr, "0.0", "en-US" ) & " 0 0 1 " & FORMAT ( bw, "0.0", "en-US" ) & ",0 V" & FORMAT ( ytop + hr2, "0.0", "en-US" ) & " Z' fill='#161616'/>"
			                            & "<circle cx='" & FORMAT ( cx, "0.0", "en-US" ) & "' cy='" & FORMAT ( ytop + rr, "0.0", "en-US" ) & "' r='" & FORMAT ( rr * 0.433, "0.0", "en-US" ) & "' fill='#fff'/>" )
			                    & IF ( yl < 136 - 6 && ( hr <= 0.5 || h - hr2 >= bw ),
			                        "<circle cx='" & FORMAT ( cx, "0.0", "en-US" ) & "' cy='" & FORMAT ( yl, "0.0", "en-US" ) & "' r='" & FORMAT ( rr * 0.433, "0.0", "en-US" ) & "' fill='#fff'/><circle cx='" & FORMAT ( cx, "0.0", "en-US" ) & "' cy='" & FORMAT ( yl, "0.0", "en-US" ) & "' r='" & FORMAT ( rr * 0.24, "0.0", "en-US" ) & "' fill='#161616'/>" )
			            ),
			        "", [Value], ASC
			    )
			VAR iMax = MAXX ( TOPN ( 1, dias, [@v], DESC, [Value], ASC ), [Value] )
			VAR iRet = IF ( MAXX ( dias, [@r] ) > 0, MAXX ( TOPN ( 1, dias, [@r], DESC, [Value], ASC ), [Value] ), -1 )
			VAR etiquetaRet =
			    IF ( iRet >= 0,
			        VAR fila = FILTER ( dias, [Value] = iRet )
			        VAR cx = 34 + ancho * ( iRet + 0.5 )
			        VAR ytop = 136 - MAX ( MAXX ( fila, [@v] ) / tope * 128, bw )
			        VAR izq = iRet >= nd - 3
			        VAR xr = IF ( izq, cx - rr - 76, cx + rr + 6 )
			        RETURN "<rect x='" & FORMAT ( xr, "0.0", "en-US" ) & "' y='" & FORMAT ( ytop + 4, "0.0", "en-US" ) & "' width='70' height='22' rx='11' fill='#161616'/>"
			            & "<text x='" & FORMAT ( xr + 35, "0.0", "en-US" ) & "' y='" & FORMAT ( ytop + 19, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='600' fill='#fff'>"
			            & FORMAT ( DIVIDE ( MAXX ( fila, [@r] ), MAXX ( fila, [@v] ) ), "0 %", "es-ES" ) & " tarde</text>" )
			VAR etiquetaMax =
			    IF ( iMax <> iRet && MAXX ( dias, [@v] ) > 0,
			        VAR fila = FILTER ( dias, [Value] = iMax )
			        VAR cx = 34 + ancho * ( iMax + 0.5 )
			        VAR ytop = 136 - MAX ( MAXX ( fila, [@v] ) / tope * 128, bw )
			        VAR xr = IF ( iMax >= 2, cx - rr - 69, cx + rr + 6 )
			        RETURN "<rect x='" & FORMAT ( xr, "0.0", "en-US" ) & "' y='" & FORMAT ( ytop - 2, "0.0", "en-US" ) & "' width='64' height='22' rx='11' fill='#E2F27A'/>"
			            & "<text x='" & FORMAT ( xr + 32, "0.0", "en-US" ) & "' y='" & FORMAT ( ytop + 13, "0.0", "en-US" ) & "' text-anchor='middle' font-size='11' font-weight='600' fill='#161616'>"
			            & FORMAT ( MAXX ( fila, [@v] ) / 1000000, "0.00", "es-ES" ) & " M€</text>" )
			VAR total = SUMX ( dias, [@v] )
			VAR n = SUMX ( dias, [@n] )
			VAR nr = SUMX ( dias, [@nr] )
			RETURN
			    "<style>" & 
			"html,body{margin:0;padding:0;overflow:hidden;background:transparent}*{box-sizing:border-box}.t{--ink:#161616;--ink2:#3B3D3A;--mut:#6F746C;--fai:#B9BDB5;--lin:#E2E5DF;--card:#F7F8F5;--lime:#E2F27A;--coral:#EF5A3C;--amber:#F0AE3A;font-family:'Segoe UI Variable Display','Segoe UI Variable Text','Segoe UI',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;height:100vh}.card{position:relative;background:var(--card);border-radius:28px;padding:18px 20px;height:100%;overflow:hidden;display:flex;flex-direction:column}.hd{display:flex;align-items:center;gap:12px}.hd .tt{font-size:15px;font-weight:600;letter-spacing:-.01em;flex:1;min-width:0}.hd .tt em{display:block;font-style:normal;font-size:11.5px;font-weight:400;color:var(--mut);letter-spacing:0;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.chip{width:36px;height:36px;border-radius:12px;background:#fff;border:1px solid var(--lin);display:flex;align-items:center;justify-content:center;flex:none}.chip svg{width:19px;height:19px}.al{display:flex;flex-direction:column;gap:8px;height:100%}.dd{font-size:12px;font-weight:600;border-radius:999px;padding:4px 9px;white-space:nowrap}.ley{display:flex;align-items:center;gap:16px;font-size:12px;color:var(--ink2);white-space:nowrap}.ley i{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px}.tot{font-size:12px;color:var(--mut)}.tot b{color:var(--ink);font-weight:600}svg .b{animation:sube .9s cubic-bezier(.2,.8,.2,1) both;transform-box:fill-box;transform-origin:bottom}@keyframes sube{from{transform:scaleY(0)}}"
			 & "</style><div class='t'>" & "<div class='card' style='padding:16px 22px'><div class='hd'><div class='chip'>" & icoBarras & "</div>"
			        & "<div class='tt' style='flex:none;font-size:22px;font-weight:400;letter-spacing:-.03em'>Llegadas al almacén</div>"
			        & "<div class='ley' style='margin-left:20px'><span><i style='background:#E2F27A'></i>a tiempo</span><span><i style='background:#161616'></i>con retraso</span>"
			        & "<span class='tot'>· <b>" & FORMAT ( total / 1000000, "0.0", "es-ES" ) & " M€</b> en <b>" & n & "</b> cargas, " & nr & " tarde</span></div>"
			        & "<div style='flex:1'></div><div style='width:196px;flex:none'></div></div>"
			        & "<svg viewBox='0 0 840 166' width='100%' height='166' style='display:block;margin-top:10px;font-family:inherit'>"
			        & rejilla & barras & etiquetaRet & etiquetaMax & "</svg></div></div>"
		displayFolder: 7 · HTML
		lineageTag: 11acd114-e264-59ed-87d7-7188d62c5602

	/// Leyenda del globo en pastillas.
	measure 'HTML · Leyenda' =
			"<style>" & 
			"html,body{margin:0;padding:0;overflow:hidden;background:transparent}*{box-sizing:border-box}.t{--ink:#161616;--ink2:#3B3D3A;--mut:#6F746C;--fai:#B9BDB5;--lin:#E2E5DF;--card:#F7F8F5;--lime:#E2F27A;--coral:#EF5A3C;--amber:#F0AE3A;font-family:'Segoe UI Variable Display','Segoe UI Variable Text','Segoe UI',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;height:100vh}.ly{display:flex;justify-content:center;align-items:center;gap:6px;height:100%}.ly span{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;color:var(--ink2);background:#fff;border:1px solid var(--lin);border-radius:999px;padding:5px 11px;white-space:nowrap}.ly .a{width:9px;height:9px;border-radius:50%}.ly .ra{width:18px;height:4px;border-radius:2px;background:#161616;box-shadow:0 0 0 2.5px var(--lime)}.ly .rp{width:18px;border-top:1.6px dashed #A3A79F}.ly .rc{width:11px;height:11px;border-radius:50%;border:1.6px dashed var(--coral)}.ly .pv{width:9px;height:9px;transform:rotate(45deg);background:#F3A3C6;border:1.2px solid #161616;border-radius:1px}.ly{gap:5px}.ly span{padding:5px 10px}"
			 & "</style><div class='t'>" & "<div class='ly'><span><i class='a' style='background:#161616'></i>En plazo</span><span><i class='a' style='background:#F0AE3A'></i>3 a 7 días tarde</span>"
			    & "<span><i class='a' style='background:#EF5A3C'></i>Más de 7 días tarde</span><span><i class='ra'></i>Ruta con viajes hoy</span>"
			    & "<span><i class='rp'></i>Ruta sin viajes</span><span><i class='rc'></i>Paso cerrado</span><span><i class='pv'></i>Proveedor</span></div></div>"
		displayFolder: 7 · HTML
		lineageTag: be18016d-824f-571e-817e-b9bd7bb6cd37

	/// Retraso medio previsto de lo que está ahora en tránsito: anticipa lo que aún no ha llegado.
	measure 'Retraso en tránsito (días)' =
			VAR t = [Momento]
			RETURN CALCULATE ( AVERAGEX ( Envios, MAX ( Envios[Retraso (días)], 0 ) ), Envios[Salida] <= t, Envios[Entrega] > t )
		formatString: 0.0
		displayFolder: 2 · En tránsito
		lineageTag: 8871b92c-9f50-5c11-9db4-0be1d8b08651

	measure 'Retraso en tránsito (Base)' = CALCULATE ( [Retraso en tránsito (días)], Escenarios[Escenario] = "Base" )
		formatString: 0.0
		displayFolder: 4 · Frente a Base
		lineageTag: 00601202-e64e-5191-9cc5-6bb396189a08

	/// Hoja de estilo común de las tarjetas HTML: colores, letra y piezas (tarjetas, cápsulas, pastillas).
	measure 'HTML · Estilo' =
			"html,body{margin:0;padding:0;overflow:hidden;background:transparent}*{box-sizing:border-box}"
			& ".t{--ink:#161616;--ink2:#3B3D3A;--mut:#6F746C;--fai:#B9BDB5;--lin:#E2E5DF;--card:#F7F8F5;--lime:#E2F27A;--coral:#EF5A3C;--amber:#F0AE3A;font-family:'Segoe UI Variable Display','Segoe UI Variable Text','Segoe UI',sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;height:100vh}"
			& ".card{position:relative;background:var(--card);border-radius:28px;padding:18px 20px;height:100%;overflow:hidden;display:flex;flex-direction:column}"
			& ".hd{display:flex;align-items:center;gap:12px}.hd .tt{font-size:15px;font-weight:600;letter-spacing:-.01em;flex:1;min-width:0}"
			& ".hd .tt em{display:block;font-style:normal;font-size:11.5px;font-weight:400;color:var(--mut);letter-spacing:0;margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			& ".chip{width:36px;height:36px;border-radius:12px;background:#fff;border:1px solid var(--lin);display:flex;align-items:center;justify-content:center;flex:none}.chip svg{width:19px;height:19px}"
			& ".mas{opacity:.8;font-size:18px;line-height:1;letter-spacing:-1px;transform:rotate(90deg)}"
			& ".big{display:flex;align-items:baseline;gap:8px;margin-top:6px;white-space:nowrap}.card>.big{margin-bottom:auto}"
			& ".big b{font-size:52px;font-weight:300;letter-spacing:-.045em;line-height:.9;font-variant-numeric:tabular-nums}"
			& ".big u{text-decoration:none;font-size:22px;font-weight:400;letter-spacing:-.02em;margin-left:-4px}.big i{font-style:normal;font-size:14px;color:var(--mut)}"
			& ".bdg{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;border-radius:999px;padding:5px 10px;background:var(--lime);align-self:center;margin-left:auto;white-space:nowrap}"
			& ".bdg.mal{background:#FBE0D8;color:#B8361B}.bdg.neu{background:rgba(255,255,255,.6)}.bdg.neg{background:var(--ink);color:var(--lime)}.bdg svg{width:13px;height:13px}"
			& ".caps{display:flex;gap:7px;margin-top:10px}.cap{flex:1;height:34px;border-radius:999px}.cap.f{background:var(--ink)}.cap.v{border:1.4px dashed var(--fai)}"
			& ".cap.f{animation:ap .5s cubic-bezier(.2,.8,.2,1) both}.cap:nth-child(2){animation-delay:.04s}.cap:nth-child(3){animation-delay:.08s}.cap:nth-child(4){animation-delay:.12s}.cap:nth-child(5){animation-delay:.16s}.cap:nth-child(6){animation-delay:.2s}.cap:nth-child(7){animation-delay:.24s}.cap:nth-child(8){animation-delay:.28s}.cap:nth-child(9){animation-delay:.32s}.cap:nth-child(10){animation-delay:.36s}@keyframes ap{from{opacity:0;transform:scale(.6)}}"
			& ".pie{margin-top:9px;font-size:12px;color:var(--mut);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			& ".lima{background:var(--lime)}.lima .chip{border-color:transparent}.lima .cap.v{border-color:rgba(22,22,22,.35)}.lima .big i,.lima .pie{color:rgba(22,22,22,.62)}"
			& ".cc{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px}.cc.ap{opacity:.28}"
			& ".tr{width:22px;height:60px;border-radius:999px;border:1.3px dashed var(--fai);position:relative}"
			& ".tr i{position:absolute;left:3px;right:3px;bottom:3px;min-height:13px;max-height:calc(100% - 6px);border-radius:999px;background:var(--ink);transform-origin:bottom;animation:sube .9s cubic-bezier(.2,.8,.2,1) both}"
			& ".tr i.l{background:var(--lime);box-shadow:inset 0 0 0 1.4px var(--ink)}.tr i.o{display:none}"
			& ".cc span{font-size:10.5px;color:var(--ink2);margin-top:4px;white-space:nowrap}.cc em{font-style:normal;font-size:10px;color:var(--mut);font-variant-numeric:tabular-nums}"
			& "@keyframes sube{from{transform:scaleY(0)}}@keyframes crece{from{transform:scaleX(0)}}"
			& ".tres{display:grid;grid-template-columns:1fr 1fr 1.25fr;gap:8px;margin-top:10px}.mi{background:#fff;border-radius:18px;padding:6px 12px 7px;white-space:nowrap}"
			& ".mi b{font-size:20px;font-weight:500;line-height:1.25;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.mi s{text-decoration:none;font-size:11px;font-weight:600;margin-left:6px;color:#4E6B00}"
			& ".mi s.m{color:#B8361B}.mi span{display:block;font-size:11px;line-height:1.2;color:var(--mut);margin-top:1px}"
