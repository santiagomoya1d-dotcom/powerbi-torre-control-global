/// Torre de control de aprovisionamiento global: un año simulado de envíos por mar, aire y carretera, con dos escenarios. Todos los datos son inventados.
model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-ES
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Envios","Viajes","Posiciones","Incidencias","Proveedores","Nodos","Rutas","Categorías","Escenarios","Modos","Calendario","Torre","CarpetaDatos"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Envios
ref table Viajes
ref table Posiciones
ref table Incidencias
ref table Proveedores
ref table Nodos
ref table Rutas
ref table Categorías
ref table Escenarios
ref table Modos
ref table Calendario
ref table Torre
ref table Medidas
ref table 'Foco desvío'
ref table Horizonte
ref table 'Envios por día'

ref cultureInfo es-ES

